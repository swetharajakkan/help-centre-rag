# Optional. Without these the app runs exactly as before and
# backend/app/tracing.py is a no-op -- no network calls, no data leaves the box.
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Optional. Set it and the answering path switches from the deterministic
# extractive engine to claude-opus-5.
# ANTHROPIC_API_KEY=sk-ant-...

# 0 restores the Week 3 fused ordering. Default is on.
HELP_CENTRE_RERANK=1

# MongoDB Atlas: sign-up accounts, the admin email list, uploaded documents.
# Copy the string from Atlas -> your cluster -> Connect -> Drivers.
# Without it, login still works with the demo accounts, but sign-up and the
# Documents tab return 503.
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority"
MONGODB_DB=help_centre

# The code an admin enters when signing up (their email must also be in the
# admin_emails collection). Change it.
HELP_CENTRE_ADMIN_CODE= HC-ADMIN-2026
# Keeps people signed in across backend restarts. Any long random string.
# HELP_CENTRE_AUTH_SECRET=
